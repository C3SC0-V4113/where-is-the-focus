---
import ValleNevadoArtwork from '../../assets/focus/valle-nevado.svg';
import { en, es, type Locale } from '../../i18n/messages';
import { ComplianceBadge } from '../common/compliance-badge';
import { RichText } from '../common/rich-text';
import { Button } from '../ui/button';
import { Input } from '../ui/input';
import { Label } from '../ui/label';
import { PatternCode } from './patterns/pattern-code';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const messages = locale === 'en' ? en : es;
const text = messages.sections.beyondRing;
const criterionTitles = messages.sections.rules.criterionTitles.split('|');
const criterionStates = messages.sections.rules.stateText.split('|');
const criterionStatus = { ok: criterionStates[0]!, warn: criterionStates[1]! };
const criterionTitleById = {
  '2.4.7': criterionTitles[0],
  '2.4.11': criterionTitles[1],
  '1.4.11': criterionTitles[2],
  '2.4.13': criterionTitles[3],
};
const href = 'https://www.w3.org/WAI/WCAG22/Understanding/focus-appearance.html';
const gallery = text.gallery;
const criteria = [
  [
    ['2.4.7', 'focus-visible.html', 'ok'],
    ['1.4.11', 'non-text-contrast.html', 'ok'],
    ['2.4.13', 'focus-appearance.html', 'warn'],
  ],
  [
    ['2.4.7', 'focus-visible.html', 'ok'],
    ['2.4.13', 'focus-appearance.html', 'ok'],
  ],
  [
    ['2.4.7', 'focus-visible.html', 'ok'],
    ['1.4.11', 'non-text-contrast.html', 'ok'],
  ],
  [
    ['2.4.7', 'focus-visible.html', 'ok'],
    ['2.4.13', 'focus-appearance.html', 'ok'],
  ],
  [
    ['2.4.7', 'focus-visible.html', 'ok'],
    ['1.4.11', 'non-text-contrast.html', 'ok'],
  ],
  [
    ['2.4.7', 'focus-visible.html', 'ok'],
    ['2.4.13', 'focus-appearance.html', 'ok'],
  ],
] as const;
const criteriaBase = 'https://www.w3.org/WAI/WCAG22/Understanding/';
---

<section class="arg grid gap-6" aria-labelledby="h-sin" id="sin-anillo">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-sin">
      {text.title}
    </h2>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    {text.paragraphs.map((paragraph) => (
      <p>
        <RichText text={paragraph} />
      </p>
    ))}
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.more.label}
    <a class="text-brand-text font-medium underline underline-offset-3" href={href}>
      {text.more.links[0]!.text}
    </a>
  </p>
  <div class="gallery grid gap-4">
    <article class="pat grid min-w-0 overflow-hidden rounded-sm border border-border bg-card">
      <div class="pat-demo grid min-h-42.5 place-items-center border-b border-border bg-background px-4.5 py-7.5">
        <div class="fld group relative grid w-full max-w-65 gap-1 font-sans">
          <Label htmlFor="g-mail" className="text-muted-foreground">
            {gallery.field.label}
          </Label>
          <Input
            id="g-mail"
            type="email"
            placeholder={gallery.field.placeholder}
            className="h-auto min-h-0 rounded-none border-0 border-b-[1.5px] border-muted-foreground bg-transparent px-0.5 py-2 text-base md:text-base dark:bg-transparent outline-hidden motion-reduce:transition-none focus-visible:ring-0"
          />
          <span
            class="bar absolute inset-x-0 bottom-0 h-0.75 scale-x-0 bg-brand-text motion-safe:transition-transform motion-safe:duration-150 group-focus-within:scale-x-100"
            aria-hidden="true"
          ></span>
        </div>
      </div>
      <div class="pat-info grid min-w-0 content-start gap-2 px-4.5 pt-4 pb-1.5 font-sans">
        <h3 class="m-0 text-lg leading-tight font-semibold text-foreground">
          {gallery.field.title}
        </h3>
        <p class="gallery-description text-muted-foreground">{gallery.field.description}</p>
        <div class="chips flex flex-wrap gap-1.5 pb-2.5">
          {criteria[0].map(([id, page, state]) => (
            <a
              class="no-underline hover:underline hover:underline-offset-3"
              href={`${criteriaBase}${page}`}
            >
              <ComplianceBadge state={state}>{id}</ComplianceBadge>
              <span class="sr-only">
                {' '}
                {criterionTitleById[id]}, {criterionStatus[state]}
              </span>
            </a>
          ))}
        </div>
      </div>
      <PatternCode
        snippet="campo"
        locale={locale}
        label={gallery.code.trigger}
        codeLabels={messages.codeExample}
        client:visible
      />
    </article>
    <article class="pat grid min-w-0 overflow-hidden rounded-sm border border-border bg-card">
      <div class="pat-demo grid min-h-42.5 place-items-center border-b border-border bg-background px-4.5 py-7.5">
        <Button
          className="gallery-invert h-auto min-h-0 cursor-pointer rounded-full border-2 border-foreground bg-transparent px-5.5 py-3 font-sans text-base font-semibold text-foreground hover:bg-foreground/10 focus-visible:border-foreground focus-visible:bg-foreground focus-visible:text-background transition-none motion-safe:transition-surface motion-safe:duration-150"
          type="button"
        >
          {gallery.button.label}
        </Button>
      </div>
      <div class="pat-info grid min-w-0 content-start gap-2 px-4.5 pt-4 pb-1.5 font-sans">
        <h3 class="m-0 text-lg leading-tight font-semibold text-foreground">
          {gallery.button.title}
        </h3>
        <p class="text-sm leading-normal text-muted-foreground">{gallery.button.description}</p>
        <div class="chips flex flex-wrap gap-1.5 pb-2.5">
          {criteria[1].map(([id, page, state]) => (
            <a
              class="no-underline hover:underline hover:underline-offset-3"
              href={`${criteriaBase}${page}`}
            >
              <ComplianceBadge state={state}>{id}</ComplianceBadge>
              <span class="sr-only">
                {' '}
                {criterionTitleById[id]}, {criterionStatus[state]}
              </span>
            </a>
          ))}
        </div>
      </div>
      <PatternCode
        snippet="invertir"
        locale={locale}
        label={gallery.code.trigger}
        codeLabels={messages.codeExample}
        client:visible
      />
    </article>
    <article class="pat grid min-w-0 overflow-hidden rounded-sm border border-border bg-card">
      <div class="pat-demo grid min-h-42.5 place-items-center border-b border-border bg-background px-4.5 py-7.5">
        <nav
          class="gallery-nav flex flex-wrap justify-center gap-x-5 gap-y-1.5 font-sans text-base font-medium"
          aria-label={gallery.nav.label}
        >
          {gallery.nav.links.map((label) => (
            <a
              class="relative py-1.5 text-foreground no-underline focus-visible:text-brand-text"
              href="#sin-anillo"
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
      <div class="pat-info grid min-w-0 content-start gap-2 px-4.5 pt-4 pb-1.5 font-sans">
        <h3 class="m-0 text-lg leading-tight font-semibold text-foreground">{gallery.nav.title}</h3>
        <p class="text-sm leading-normal text-muted-foreground">{gallery.nav.description}</p>
        <div class="chips flex flex-wrap gap-1.5 pb-2.5">
          {criteria[2].map(([id, page, state]) => (
            <a
              class="no-underline hover:underline hover:underline-offset-3"
              href={`${criteriaBase}${page}`}
            >
              <ComplianceBadge state={state}>{id}</ComplianceBadge>
              <span class="sr-only">
                {' '}
                {criterionTitleById[id]}, {criterionStatus[state]}
              </span>
            </a>
          ))}
        </div>
      </div>
      <PatternCode
        snippet="nav"
        locale={locale}
        label={gallery.code.trigger}
        codeLabels={messages.codeExample}
        client:visible
      />
    </article>
    <article class="pat grid min-w-0 overflow-hidden rounded-sm border border-border bg-card">
      <div class="pat-demo grid min-h-42.5 place-items-center border-b border-border bg-background px-4.5 py-7.5">
        <p class="hl-p gallery-highlight m-0 max-w-80 font-serif text-base leading-relaxed text-foreground">
          {gallery.highlight.lead}
          <a
            class="hl rounded-sm text-foreground underline decoration-brand-text underline-offset-3 focus-visible:text-brand-foreground focus-visible:decoration-transparent"
            href="#sin-anillo"
          >
            {gallery.highlight.first}
          </a>
          {gallery.highlight.between}
          <a
            class="hl rounded-sm text-foreground underline decoration-brand-text underline-offset-3 focus-visible:text-brand-foreground focus-visible:decoration-transparent"
            href="#sin-anillo"
          >
            {gallery.highlight.second}
          </a>
          {gallery.highlight.end}
        </p>
      </div>
      <div class="pat-info grid min-w-0 content-start gap-2 px-4.5 pt-4 pb-1.5 font-sans">
        <h3 class="m-0 text-lg leading-tight font-semibold text-foreground">
          {gallery.highlight.title}
        </h3>
        <p class="text-sm leading-normal text-muted-foreground">{gallery.highlight.description}</p>
        <div class="chips flex flex-wrap gap-1.5 pb-2.5">
          {criteria[3].map(([id, page, state]) => (
            <a
              class="no-underline hover:underline hover:underline-offset-3"
              href={`${criteriaBase}${page}`}
            >
              <ComplianceBadge state={state}>{id}</ComplianceBadge>
              <span class="sr-only">
                {' '}
                {criterionTitleById[id]}, {criterionStatus[state]}
              </span>
            </a>
          ))}
        </div>
      </div>
      <PatternCode
        snippet="subrayador"
        locale={locale}
        label={gallery.code.trigger}
        codeLabels={messages.codeExample}
        client:visible
      />
    </article>
    <article class="pat grid min-w-0 overflow-hidden rounded-sm border border-border bg-card">
      <div class="pat-demo grid min-h-42.5 place-items-center border-b border-border bg-background px-4.5 py-7.5">
        <a
          class="vis relative grid w-full max-w-62.5 gap-1 rounded-md border border-border bg-card px-5 py-4 font-sans text-foreground no-underline"
          href="#sin-anillo"
        >
          <strong class="text-base">{gallery.viewfinder.plan}</strong>
          <span class="text-sm text-muted-foreground">{gallery.viewfinder.details}</span>
        </a>
      </div>
      <div class="pat-info grid min-w-0 content-start gap-2 px-4.5 pt-4 pb-1.5 font-sans">
        <h3 class="m-0 text-lg leading-tight font-semibold text-foreground">
          {gallery.viewfinder.title}
        </h3>
        <p class="text-sm leading-normal text-muted-foreground">{gallery.viewfinder.description}</p>
        <div class="chips flex flex-wrap gap-1.5 pb-2.5">
          {criteria[4].map(([id, page, state]) => (
            <a
              class="no-underline hover:underline hover:underline-offset-3"
              href={`${criteriaBase}${page}`}
            >
              <ComplianceBadge state={state}>{id}</ComplianceBadge>
              <span class="sr-only">
                {' '}
                {criterionTitleById[id]}, {criterionStatus[state]}
              </span>
            </a>
          ))}
        </div>
      </div>
      <PatternCode
        snippet="visor"
        locale={locale}
        label={gallery.code.trigger}
        codeLabels={messages.codeExample}
        client:visible
      />
    </article>
    <article class="pat grid min-w-0 overflow-hidden rounded-sm border border-border bg-card">
      <div class="pat-demo grid min-h-42.5 place-items-center border-b border-border bg-background px-4.5 py-7.5">
        <a
          class="thumb group relative block aspect-4/3 w-full max-w-65 overflow-hidden rounded-md bg-muted no-underline"
          href="#sin-anillo"
          aria-label={gallery.overlay.ariaLabel}
        >
          <ValleNevadoArtwork
            class="absolute inset-0 block size-full"
            aria-hidden="true"
            focusable="false"
          />
          <span
            class="veil absolute inset-0 grid place-items-center bg-brand/88 font-sans text-base font-semibold text-brand-foreground opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 group-focus-visible:inset-ring-3 group-focus-visible:inset-ring-brand-foreground motion-safe:transition-opacity"
            aria-hidden="true"
          >
            {gallery.overlay.action}
          </span>
        </a>
      </div>
      <div class="pat-info grid min-w-0 content-start gap-2 px-4.5 pt-4 pb-1.5 font-sans">
        <h3 class="m-0 text-lg leading-tight font-semibold text-foreground">
          {gallery.overlay.title}
        </h3>
        <p class="text-sm leading-normal text-muted-foreground">{gallery.overlay.description}</p>
        <div class="chips flex flex-wrap gap-1.5 pb-2.5">
          {criteria[5].map(([id, page, state]) => (
            <a
              class="no-underline hover:underline hover:underline-offset-3"
              href={`${criteriaBase}${page}`}
            >
              <ComplianceBadge state={state}>{id}</ComplianceBadge>
              <span class="sr-only">
                {' '}
                {criterionTitleById[id]}, {criterionStatus[state]}
              </span>
            </a>
          ))}
        </div>
      </div>
      <PatternCode
        snippet="capa"
        locale={locale}
        label={gallery.code.trigger}
        codeLabels={messages.codeExample}
        client:visible
      />
    </article>
  </div>
</section>
