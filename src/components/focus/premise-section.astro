---
import { en, es, type Locale } from '../../i18n/messages';
import { RichText } from '../common/rich-text';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (locale === 'en' ? en : es).sections.premise;
---

<section class="arg grid gap-6" aria-labelledby="h-plan" id="planteamiento">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-plan">
      {text.title} <span class="soft text-muted-foreground">{text.soft}</span>
    </h2>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    <p>{text.intro}</p>
    <p>{text.lead}</p>
  </div>
  <div class="split grid overflow-hidden border border-border md:grid-cols-2">
    <div class="grid content-start gap-3.5">
      <h3 class="m-0 font-display font-stretch-75% text-2xl font-extrabold uppercase">
        {text.failTitle}
      </h3>
      <ol role="list" class="m-0 grid list-none gap-3 p-0">
        {text.failures.split('|').map((item) => (
          <li class="grid gap-2.5">
            <RichText text={item} />
          </li>
        ))}
      </ol>
    </div>
    <div class="good grid content-start gap-3.5 bg-brand text-brand-foreground">
      <h3 class="m-0 font-display font-stretch-75% text-2xl font-extrabold uppercase">
        {text.goodTitle}
      </h3>
      <ol role="list" class="m-0 grid list-none gap-3 p-0">
        {text.good.split('|').map((item) => (
          <li class="grid gap-2.5">
            <RichText text={item} />
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
