---
import { en, es, type Locale } from '../../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = locale === 'en' ? en : es;
const numbers = ['01', '02', '03', '04', '05', '06', '07', '08'] as const;
---

<div class="hero mx-auto grid w-full max-w-5xl gap-7 px-4">
  <span class="eyebrow font-mono font-medium text-muted-foreground uppercase">
    {messages.heroEyebrow}
  </span>
  <h1 class="display font-display text-balance uppercase">
    {messages.heroTitleBefore}
    <span class="ringed relative inline-block">{messages.heroTitleRinged}</span>
    {messages.heroTitleAfter}
  </h1>
  <p class="hero-lede font-serif">{messages.description}</p>
</div>

<nav
  aria-label={messages.tocLabel}
  class="toc mx-auto mb-6 w-full max-w-5xl border-t-2 border-b border-t-foreground border-b-border px-4 pt-5 pb-5.5"
>
  <ol role="list" class="grid gap-x-7 gap-y-0.5">
    {numbers.map((number) => (
      <li class="grid gap-2 py-2 font-sans font-medium text-foreground">
        <span class="toc-number font-mono font-medium text-muted-foreground" aria-hidden="true">
          {number}
        </span>
        <span class="toc-label">{messages[`tocEntry${number}`]}</span>
      </li>
    ))}
  </ol>
</nav>
