---
import { en, es, type Locale } from '../../i18n/messages';
import { RichText } from '../common/rich-text';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (locale === 'en' ? en : es).sections.beyondRing;
const href = 'https://www.w3.org/WAI/WCAG22/Understanding/focus-appearance.html';
---

<section class="arg grid gap-6" aria-labelledby="h-sin" id="sin-anillo">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-sin">
      {text.title}
    </h2>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    {text.paragraphs.map((paragraph) => (
      <p>
        <RichText text={paragraph} />
      </p>
    ))}
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.more.label}
    <a class="text-brand-text font-medium underline underline-offset-3" href={href}>
      {text.more.links[0]!.text}
    </a>
  </p>
</section>
