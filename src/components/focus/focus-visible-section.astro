---
import { en, es, type Locale } from '../../i18n/messages';
import { getSnippetCode, snippets } from '../../lib/focus/snippets';
import { CodeExample } from '../common/code-example';
import { RichText } from '../common/rich-text';
import { LabFocusVisible } from './labs/lab-focus-visible';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (locale === 'en' ? en : es).sections.focusVisible;
const snippet = snippets.fv;
const css = getSnippetCode(snippet, 'css', locale);
const tailwind = getSnippetCode(snippet, 'tw', locale);
const hrefs = [
  locale === 'en'
    ? 'https://developer.mozilla.org/en-US/docs/Web/CSS/:focus-visible'
    : 'https://developer.mozilla.org/es/docs/Web/CSS/:focus-visible',
  'https://vercel.com/design/guidelines#interactions',
];
---

<section class="arg grid gap-6" aria-labelledby="h-fv" id="focus-visible">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-fv">
      {text.title}
    </h2>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    {text.paragraphs.map((paragraph) => (
      <p>
        <RichText text={paragraph} />
      </p>
    ))}
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.more.label}
    {text.more.links.map((link, index) => (
      <>
        {index > 0 && text.more.separator}
        <a class="text-brand-text font-medium underline underline-offset-3" href={hrefs[index]}>
          {link.text}
        </a>
      </>
    ))}
  </p>
  <div id="lab-fv" class="lab overflow-hidden rounded-md border border-border bg-card">
    <div class="lab-head flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-border px-4 py-3.5">
      <span class="lab-title flex items-center gap-2.5 font-mono text-xs font-semibold tracking-wider uppercase">
        <span aria-hidden="true" class="size-2.5 rounded-sm border-2 border-brand-text"></span>
        {text.lab1.title}
      </span>
      <div class="lab-task text-sm leading-relaxed text-muted-foreground">
        <RichText text={text.lab1.task} />
      </div>
    </div>
    <div class="lab-body grid gap-4 p-4 sm:gap-5 sm:p-6">
      <LabFocusVisible locale={locale} client:visible />
      <CodeExample
        client:visible
        css={css}
        tailwind={tailwind}
        labels={(locale === 'en' ? en : es).codeExample}
      />
    </div>
  </div>
</section>
