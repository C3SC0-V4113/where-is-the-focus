---
import { en, es, type Locale } from '../../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = locale === 'en' ? en : es;
---

<div class="hero mx-auto grid w-full max-w-5xl gap-7 px-4">
  <span class="eyebrow">{messages.heroEyebrow}</span>
  <h1 class="display">
    {messages.heroTitleBefore}
    <span class="ringed">{messages.heroTitleRinged}</span>
    {messages.heroTitleAfter}
  </h1>
  <p class="hero-lede">{messages.description}</p>
</div>
