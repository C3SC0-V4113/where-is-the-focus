---
import { en, es, type Locale } from '../../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = locale === 'en' ? en : es;
const entries = [
  messages.tocEntry01,
  messages.tocEntry02,
  messages.tocEntry03,
  messages.tocEntry04,
  messages.tocEntry05,
  messages.tocEntry06,
  messages.tocEntry07,
  messages.tocEntry08,
];
---

<nav aria-label={messages.tocLabel} class="toc mx-auto mb-6 w-full max-w-5xl px-4">
  <ol role="list">
    {entries.map((entry, index) => (
      <li>
        <span class="toc-number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <span class="toc-label">{entry}</span>
      </li>
    ))}
  </ol>
</nav>
