---
import { en, es, type Locale } from '../../i18n/messages';
import { getSnippetCode, snippets } from '../../lib/focus/snippets';
import { CodeExample } from '../common/code-example';
import { RichText } from '../common/rich-text';
import { LabRing } from './labs/lab-ring';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (locale === 'en' ? en : es).sections.ring;
const snippet = snippets.shadcn;
const css = getSnippetCode(snippet, 'css', locale);
const tailwind = getSnippetCode(snippet, 'tw', locale);
const hrefs = [
  'https://www.sarasoueidan.com/blog/focus-indicators/',
  'https://ui.shadcn.com/docs/theming',
];
---

<section class="arg grid gap-6" aria-labelledby="h-anillo" id="anillo">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-anillo">
      {text.title}
    </h2>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    {text.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.more.label}
    <a class="text-brand-text font-medium underline underline-offset-3" href={hrefs[0]}>
      {text.more.links[0]!.text}
    </a>
    {text.more.after}
  </p>
  <div id="lab-anillo" class="lab overflow-hidden rounded-md border border-border bg-card">
    <div class="lab-head flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-border px-4 py-3.5">
      <span class="lab-title flex items-center gap-2.5 font-mono text-xs font-semibold tracking-wider uppercase">
        <span aria-hidden="true" class="size-2.5 rounded-sm border-2 border-brand-text"></span>
        {text.lab2.title}
      </span>
      <div class="lab-task text-sm leading-relaxed text-muted-foreground">
        <RichText text={text.lab2.task} />
      </div>
    </div>
    <div class="lab-body grid gap-4 p-4 sm:gap-5 sm:p-6">
      <LabRing client:visible locale={locale} />
    </div>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    <p class="pull my-1.5 font-display text-pull text-pretty font-stretch-75% normal-case">
      <RichText text={text.pull} />
    </p>
    <p>
      <RichText text={text.pullParagraph} />
    </p>
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.pullMore.label}
    <a class="text-brand-text font-medium underline underline-offset-3" href={hrefs[1]}>
      {text.pullMore.links[0]!.text}
    </a>
  </p>
  <CodeExample
    client:visible
    css={css}
    tailwind={tailwind}
    labels={(locale === 'en' ? en : es).codeExample}
  />
</section>
