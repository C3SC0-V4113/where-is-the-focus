---
import { en, es, type Locale } from '../../i18n/messages';
import { RichText } from '../common/rich-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = locale === 'en' ? en : es;
const numbers = ['01', '02', '03', '04', '05', '06', '07', '08'] as const;
---

<div class="hero mx-auto grid w-full max-w-5xl gap-7 px-4">
  <span class="eyebrow font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase">
    {messages.heroEyebrow}
  </span>
  <h1 class="font-display text-display font-stretch-66% text-balance uppercase">
    {messages.heroTitleBefore}
    <span class="ringed relative inline-block">{messages.heroTitleRinged}</span>
    {messages.heroTitleAfter}
  </h1>
  <p class="hero-lede max-w-lede font-serif text-lede">{messages.description}</p>
  <div class="hero-meta flex flex-wrap items-center gap-x-5.5 gap-y-2.5 font-sans text-sm text-muted-foreground">
    <span class="tab-hint inline-flex items-center gap-2 text-sm font-medium text-foreground">
      <span aria-hidden="true" class="size-2 rounded-full bg-brand"></span>
      <RichText text={messages.heroTabHint} />
    </span>
    <span class="hero-meta-line">{messages.heroMeta}</span>
  </div>
</div>

<nav
  aria-label={messages.tocLabel}
  class="toc mx-auto mb-6 w-full max-w-5xl border-t-2 border-b border-t-foreground border-b-border px-4 pt-5 pb-5.5"
>
  <ol role="list" class="grid gap-x-7 gap-y-0.5">
    {numbers.map((number) => (
      <li class="grid items-start gap-2 py-2 font-sans text-base leading-snug font-medium text-foreground">
        <span
          class="toc-number font-mono text-xs leading-5 font-medium text-muted-foreground"
          aria-hidden="true"
        >
          {number}
        </span>
        <span class="toc-label">{messages[`tocEntry${number}`]}</span>
      </li>
    ))}
  </ol>
</nav>
