---
import { en, es, type Locale } from '../../i18n/messages';
import { RichText } from '../common/rich-text';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (locale === 'en' ? en : es).sections.ring;
const hrefs = [
  'https://www.sarasoueidan.com/blog/focus-indicators/',
  'https://ui.shadcn.com/docs/theming',
];
---

<section class="arg grid gap-6" aria-labelledby="h-anillo" id="anillo">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-anillo">
      {text.title}
    </h2>
  </div>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    {text.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.more.label}
    <a class="text-brand-text font-medium underline underline-offset-3" href={hrefs[0]}>
      {text.more.links[0]!.text}
    </a>
    {text.more.after}
  </p>
  <div class="intro grid max-w-prose gap-4 font-serif text-lg leading-relaxed">
    <p class="pull font-display text-pull text-pretty font-stretch-75% normal-case">
      <RichText text={text.pull} />
    </p>
    <p>
      <RichText text={text.pullParagraph} />
    </p>
  </div>
  <p class="more m-0 max-w-prose text-sm leading-normal text-muted-foreground">
    {text.pullMore.label}
    <a class="text-brand-text font-medium underline underline-offset-3" href={hrefs[1]}>
      {text.pullMore.links[0]!.text}
    </a>
  </p>
</section>
