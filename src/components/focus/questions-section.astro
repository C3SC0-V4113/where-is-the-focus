---
import { en, es, type Locale } from '../../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = (locale === 'en' ? en : es).sections.objections;
---

<section class="arg grid gap-6" aria-labelledby="h-obj" id="objeciones">
  <div class="head grid gap-3.5">
    <span class="num font-mono text-xs font-medium tracking-wider text-muted-foreground">
      {text.number}
    </span>
    <h2 class="m-0 font-display text-section font-stretch-66% text-balance uppercase" id="h-obj">
      {text.title}
    </h2>
  </div>
</section>
