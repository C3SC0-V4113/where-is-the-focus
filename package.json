{
  "name": "where-is-the-focus",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "lint": "eslint . --no-warn-ignored --max-warnings 0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings 0",
    "doctor": "astro check && react-doctor . --yes --blocking warning",
    "doctor:design": "react-doctor design . --yes --blocking warning",
    "doctor:staged": "astro check --noSync && react-doctor . --staged --blocking warning",
    "doctor:ci": "astro check && react-doctor . --yes --blocking warning",
    "scan:init": "astro dev --background",
    "scan": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test && pnpm run doctor:ci",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.14.0",
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-doctor": "0.9.18",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-doctor": "0.9.18",
    "shadcn": "^4.22.1",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
