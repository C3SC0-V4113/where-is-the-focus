---
import LangSwitch from '../components/common/lang-switch.astro';
import { ThemeToggle } from '../components/common/theme-toggle';
import { en, es, type Locale } from '../i18n/messages';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = locale === 'en' ? en : es;
---

<html lang={locale}>
  <head>
    <script is:inline>
      (() => {
        let theme = null;
        try {
          const storedTheme = localStorage.getItem('foco-theme');
          if (storedTheme === 'light' || storedTheme === 'dark') {
            theme = storedTheme;
          }
        } catch {
          // Storage may be disabled or unavailable.
        }

        if (theme === null) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <title>{messages.title}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {import.meta.env.DEV && (
      <script
        is:inline
        crossorigin="anonymous"
        src="//unpkg.com/react-scan@0.5.7/dist/auto.global.js"
      ></script>
    )}
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-4 focus:py-3 focus:text-foreground"
    >
      {messages.skipLink}
    </a>
    <header class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 border-b border-border px-4 py-4">
      <a href="#contenido" class="min-w-0 font-semibold text-foreground hover:underline">
        {messages.title}
      </a>
      <div class="flex shrink-0 items-center gap-1.5">
        <LangSwitch locale={locale} />
        <ThemeToggle
          client:load
          label={messages.themeLabel}
          light={messages.themeLight}
          dark={messages.themeDark}
        />
      </div>
    </header>
    <main id="contenido" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-4 py-16">
      <slot />
    </main>
    <footer class="mt-auto border-t border-border">
      <p class="mx-auto w-full max-w-5xl px-4 py-6 text-sm text-muted-foreground">
        {messages.footerName} · {messages.footerRole}
      </p>
    </footer>
  </body>
</html>
